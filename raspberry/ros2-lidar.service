[Unit]
Description=ROS2 Jazzy RPLIDAR
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ws
ExecStartPre=-/usr/bin/docker rm -f ros2-lidar
ExecStart=/usr/bin/docker run --rm --name ros2-lidar \
  --device=/dev/rplidar \
  --device=/dev/ttyUSB0 \
  --network=host \
  --volume=rasprover-maps:/maps \
  --env=FASTDDS_DEFAULT_PROFILES_FILE=/opt/rasprover/fastdds_udp_only.xml \
  ros2-lidar \
  ros2 launch rplidar_ros rplidar.launch.py
ExecStop=/usr/bin/docker stop -t 10 ros2-lidar
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
