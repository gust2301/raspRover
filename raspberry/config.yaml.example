# Configuration du RaspRover
# Modifier ici sans toucher au code.

rover:
  name: "rasprover"          # Identifiant unique du rover (utilisé comme préfixe dans R2)

control:
  # Port série UART de la Pi 5 vers l'ESP32 Waveshare.
  # - Matériel réel : /dev/ttyAMA0 (UART Pi 5) ou /dev/ttyUSB0 (ESP32 en USB)
  # - Émulateur   : socket://localhost:9999   (lancer `python3 -m tools.fake_esp32`)
  serial_port: /dev/ttyAMA0
  baudrate: 115200
  timeout_s: 1.0
  esp32_required: false       # false = l'API demarre meme si l'ESP32 est absent

  # Limites de sécurité
  motor_max_speed: 0.5        # Vitesse maximale normalisée (0.0 à 1.0)
  motor_default_speed: 0.35   # Vitesse par défaut
  command_rate_hz: 20         # Fréquence max d'envoi de commandes

  pantilt:
    pan_min_deg: -90
    pan_max_deg:  90
    tilt_min_deg: -45
    tilt_max_deg:  60
    servo_speed: 600          # Vitesse servo ST3215 (0-4096)
    servo_accel: 50           # Accélération servo ST3215 (0-255)

drive:
  control_mode: "driver"      # driver | mirror
  invert_x: false
  invert_y: false
  invert_left_motor: false
  invert_right_motor: false
  max_speed: 0.5

logging:
  level: INFO
  file: logs/rasprover.log

api:
  host: 0.0.0.0
  port: 8080
  https:
    enabled: true
    port: 8443
    certfile: certs/rasprover.crt
    keyfile: certs/rasprover.key
    auto_generate: true
    common_name: 192.168.1.24
    subject_alt_names:
      - IP:192.168.1.24
      - DNS:localhost
      - IP:127.0.0.1

camera:
  width: 640
  height: 480
  framerate: 24

audio:
  # Device ALSA pour la sortie audio (haut-parleur de la caméra).
  # Laisser vide : le code détecte automatiquement la première carte USB (recommandé).
  device: ""

sensors:
  ultrasonic:
    enabled: false            # HC-SR04 retire : garder false pour LIDAR_ONLY
    # port: "/dev/ttyACM0"   # Laisser vide = auto-détection du port Arduino
    baudrate: 9600            # Doit correspondre au sketch Arduino
    obstacle_threshold_cm: 20 # Distance en cm en dessous de laquelle obstacle=true

  lidar:
    enabled: false            # RPLIDAR A1 serie — desactive, ROS2 (ros2-lidar) est utilise a la place

  ros2_lidar:
    # Offset pour aligner le 0° du scan ROS2 avec l'avant du robot.
    # Mesure : mettre un objet devant le robot, lire l'angle_deg du point le plus proche
    # dans /api/lidar/scan, puis angle_offset_deg = (360 - angle_mesure) % 360
    angle_offset_deg: 140     # (scan_angle + 140) % 360 = angle robot. Ajuster si avant/arriere inverses (+/-180)
    obstacle_threshold_cm: 45 # Seuil frontal pour la securite manuelle et la patrouille

  vision:
    enabled: true             # Détection d'obstacles par caméra (OpenCV dual-méthode)
                              # Nécessite : sudo apt install python3-opencv
    edge_threshold: 0.08      # Méthode A — Canny : densité d'arêtes (0-1) déclenchant "obstacle"
                              # Pour obstacles texturés : chaises, câbles, personnes…
    uniform_std_max: 28.0     # Méthode B — Surface lisse : écart-type max du ROI
                              # Pour obstacles lisses : murs blancs, meubles, portes…
                              # Réduire (ex: 12) si faux positifs sur sol uniforme
    history: 3                # Nombre de frames pour le vote majoritaire (lissage)

patrol:
  navigation_mode: "LIDAR_ONLY" # LIDAR_ONLY | HYBRID | LEGACY
  speed: 0.3                # Vitesse d'avance (0-1)
  obstacle_cm: 70           # Seuil obstacle (cm) pour l'évitement LIDAR
  lidar_stop_cm: 32         # Stop immediat si obstacle frontal/lateral tres proche
  lidar_warning_cm: 65      # Zone prudente: ralentir ou corriger la trajectoire
  lidar_safe_cm: 110        # Distance consideree libre pour avancer
  turn_clearance_cm: 55     # Distance minimale gauche/droite pour tourner
  rear_clearance_cm: 50     # Distance minimale arriere pour reculer
  min_decision_duration_ms: 1200 # Anti-oscillation entre deux decisions
  patrol_forward_speed: 0.3 # Vitesse d'avance en LIDAR_ONLY
  patrol_turn_speed: 0.42   # Vitesse de rotation en LIDAR_ONLY
  scan_zone_min_points: 2   # Points minimum par zone pour valider la mesure
  step_duration: 0.7        # Durée d'une étape d'avance (s) — scan entre chaque étape
  stuck_timeout: 3.5        # Secondes en FORWARD sans obstacle → angle mort détecté
  scan_with_pantilt: false  # true = sweep caméra gauche/centre/droite avant chaque étape
                            # plus précis pour les angles morts, mais plus lent (~1s/scan)

storage:
  r2:
    # Laisser endpoint_url vide pour désactiver le stockage R2.
    # Prérequis sur la Pi : pip install boto3  &&  sudo apt install ffmpeg
    endpoint_url: ""          # ex: https://<account_id>.r2.cloudflarestorage.com
    access_key_id: ""
    secret_access_key: ""
    bucket_name: "rasprover-media"
    presigned_url_expiry_s: 3600   # Durée de vie des URLs signées (1h)
