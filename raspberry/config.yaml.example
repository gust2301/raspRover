# Configuration du RaspRover
# Modifier ici sans toucher au code.

control:
  # Port série UART de la Pi 5 vers l'ESP32 Waveshare.
  # - Matériel réel : /dev/ttyAMA0 (UART Pi 5) ou /dev/ttyUSB0 (ESP32 en USB)
  # - Émulateur   : socket://localhost:9999   (lancer `python3 -m tools.fake_esp32`)
  serial_port: socket://localhost:9999
  baudrate: 115200
  timeout_s: 1.0

  # Limites de sécurité
  motor_max_speed: 0.5        # Vitesse maximale normalisée (0.0 à 1.0)
  motor_default_speed: 0.35   # Vitesse par défaut
  command_rate_hz: 20         # Fréquence max d'envoi de commandes

  pantilt:
    pan_min_deg: -90
    pan_max_deg:  90
    tilt_min_deg: -45
    tilt_max_deg:  60
    servo_speed: 600          # Vitesse servo ST3215 (0-4096)
    servo_accel: 50           # Accélération servo ST3215 (0-255)

drive:
  control_mode: "driver"      # driver | mirror
  invert_x: false
  invert_y: false
  invert_left_motor: false
  invert_right_motor: false
  max_speed: 0.5

logging:
  level: INFO
  file: logs/rasprover.log

api:
  host: 0.0.0.0
  port: 8080
  https:
    enabled: true
    port: 8443
    certfile: certs/rasprover.crt
    keyfile: certs/rasprover.key
    auto_generate: true
    common_name: 192.168.1.121
    subject_alt_names:
      - IP:192.168.1.121
      - DNS:localhost
      - IP:127.0.0.1

camera:
  width: 640
  height: 480
  framerate: 24

audio:
  # Device ALSA pour la sortie audio (haut-parleur de la caméra).
  # Laisser vide : le code détecte automatiquement la première carte USB (recommandé).
  device: ""

sensors:
  ultrasonic:
    enabled: true             # Mettre false pour désactiver le capteur
    # port: "/dev/ttyACM0"   # Laisser vide = auto-détection du port Arduino
    baudrate: 9600            # Doit correspondre au sketch Arduino
    obstacle_threshold_cm: 20 # Distance en cm en dessous de laquelle obstacle=true

  vision:
    enabled: true             # Détection d'obstacles par caméra (OpenCV dual-méthode)
                              # Nécessite : sudo apt install python3-opencv
    edge_threshold: 0.08      # Méthode A — Canny : densité d'arêtes (0-1) déclenchant "obstacle"
                              # Pour obstacles texturés : chaises, câbles, personnes…
    uniform_std_max: 28.0     # Méthode B — Surface lisse : écart-type max du ROI
                              # Pour obstacles lisses : murs blancs, meubles, portes…
                              # Réduire (ex: 12) si faux positifs sur sol uniforme
    history: 3                # Nombre de frames pour le vote majoritaire (lissage)

patrol:
  speed: 0.3                # Vitesse d'avance (0-1)
  obstacle_cm: 40           # Seuil ultrason (cm) déclenchant l'évitement
  step_duration: 0.7        # Durée d'une étape d'avance (s) — scan entre chaque étape
  stuck_timeout: 3.5        # Secondes en FORWARD sans obstacle → angle mort détecté
  scan_with_pantilt: false  # true = sweep caméra gauche/centre/droite avant chaque étape
                            # plus précis pour les angles morts, mais plus lent (~1s/scan)
