FROM ros:jazzy-ros-base

# Install RPLIDAR, SLAM toolbox and the Nav2 runtime in a single layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-rplidar-ros \
    ros-jazzy-slam-toolbox \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    && rm -rf /var/lib/apt/lists/*

# Source ROS on every exec (needed for docker exec ros2 ... calls)
RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

COPY map_writer.py /opt/rasprover/map_writer.py
COPY modules/control/encoder_kinematics.py /opt/rasprover/encoder_kinematics.py
COPY ros/ /opt/rasprover/
RUN chmod +x /opt/rasprover/start_slam.sh /opt/rasprover/start_navigation.sh

SHELL ["/bin/bash", "-c"]
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
